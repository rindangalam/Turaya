# ============================================================
# TURAYA — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env* files. NEVER expose SUPABASE_SERVICE_ROLE_KEY
# to the browser. See docs/SECURITY.md.

# --- Supabase (public — safe for client bundle) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# --- Supabase (server-only — never in client code) ---
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# --- Site URL (canonical / sitemap / robots / Open Graph) ---
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- PostgreSQL (server-only, for tooling / migrations) ---
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
